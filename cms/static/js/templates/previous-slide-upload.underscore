<div class="slide-row-container">
    <div class="slide-col name-col"><%- client_slide_id %></div>
    <div class="slide-col date-col"><%- created %></div>
    <div class="slide-col slide-id-col"><%- slide_id %></div>
    <div class="slide-col status-col"><%- status %></div>
    <div class="slide-col public-url-col">
        <% if (public_url) { %>
            <button type="button" class="copy-public-url-btn" data-url="<%- public_url %>">
                <%- gettext("Copy") %>
            </button>
            <span class="copy-success-message" style="display:none;color:green;margin-left:5px;">
                <%- gettext("Copied!") %>
            </span>
        <% } %>
    </div>
    <div class="slide-col actions-col">
        <ul class="actions-list">
            <li class="action-item action-remove">
                <a href="#" data-tooltip="<%- gettext('Remove this slide') %>" class="remove-slide-button action-button">
                    <span class="icon fa fa-times-circle" aria-hidden="true"></span>
                    <span class="sr"><%- StringUtils.interpolate(gettext("Remove {slide_name} slide"), {slide_name: client_slide_id}) %></span>
                </a>
            </li>
        </ul>
    </div>
</div>