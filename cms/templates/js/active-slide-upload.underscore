
<h4 class="slide-detail-name">&lt;%- fileName %>
</h4>
<progress class="slide-detail-progress" value="<%- progress %>"></progress>
<div class="slide-upload-status">
    <span class="icon alert-icon fa fa-warning upload-failure" aria-hidden="true"></span>
    <span class="slide-detail-status"><%- gettext(status) %></span>
    <% if (failureMessage) { %>
        <a href="#" class="more-details-action">
            <%- gettext("Read More") %>
            <span class="sr"><%- gettext("details about the failure") %></span>
        </a>
    <% } %>
</div>